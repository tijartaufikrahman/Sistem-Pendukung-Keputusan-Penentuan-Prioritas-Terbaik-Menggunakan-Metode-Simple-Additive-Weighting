@{
    ViewData["Title"] = "Lupa Kata Sandi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Lupa Kata Sandi - SPK Penentuan Prioritas Alternatif Terbaik</title>
    <!-- Bootstrap 5 CSS untuk Struktur Dasar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image: radial-gradient(circle at 20% 30%, rgba(45,212,191,.15) 0%, transparent 50%),
                              radial-gradient(circle at 80% 70%, rgba(56,189,248,.12) 0%, transparent 50%);
        }
        .card {
            width: 100%; max-width: 420px; background: #fff; border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px; border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 22px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 26px; }
        .logo {
            width: 64px; height: 64px; background: linear-gradient(135deg,#2dd4bf,#0d9488);
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px; box-shadow: 0 8px 24px rgba(13,148,136,.25);
            transform: rotate(-3deg); transition: transform .3s ease;
        }
        .logo:hover { transform: rotate(0deg) scale(1.05); }
        .logo i { font-size: 28px; color: #fff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 4px; }
        .header p { color: #64748b; font-size: 13px; line-height: 1.6; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 7px; }
        .input-wrapper { position: relative; }
        .input-wrapper i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; }
        .form-group input {
            width: 100%; padding: 12px 14px 12px 42px; border: 1.5px solid #e2e8f0;
            border-radius: 12px; font-size: 14px; color: #1e293b; background: #f8fafc; outline: none; transition: all .2s;
        }
        .form-group input:focus { border-color: #2dd4bf; background: #fff; box-shadow: 0 0 0 3px rgba(45,212,191,.15); }
        .btn {
            width: 100%; padding: 13px; background: linear-gradient(135deg,#2dd4bf,#0d9488);
            color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; transition: all .25s; display: flex; align-items: center;
            justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(13,148,136,.3);
        }
        .btn:hover { transform: translateY(-1px); }
        .btn:disabled { opacity: 0.7; cursor: not-allowed; }
        .error-msg {
            background: #fef2f2; color: #dc2626; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #fecaca;
            display: flex; align-items: center; gap: 8px;
        }
        .success-msg {
            background: #f0fdf4; color: #166534; padding: 11px 14px; border-radius: 10px;
            font-size: 13px; margin-bottom: 16px; border: 1px solid #bbf7d0;
            display: flex; align-items: center; gap: 8px;
        }
        .back-link { text-align: center; margin-top: 20px; font-size: 13px; color: #64748b; }
        .back-link a { color: #0d9488; text-decoration: none; font-weight: 500; }
        .back-link a:hover { text-decoration: underline; }
        .info-box {
            background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 12px;
            padding: 14px 16px; font-size: 12.5px; color: #475569; line-height: 1.6; margin-bottom: 20px;
        }
        .info-box i { color: #0d9488; margin-right: 6px; }
    </style>
</head>
<body>
    <!-- ATURAN 1: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="card">
            <div class="header">
                <div class="logo"><i class="fas fa-key"></i></div>
                <h1>Lupa Kata Sandi?</h1>
                <p>Masukkan alamat email akun SPK Anda untuk menerima 6-digit kode OTP reset kata sandi.</p>
            </div>

            <div id="alertArea"></div>

            <div class="info-box">
                <i class="fas fa-info-circle"></i> Pastikan alamat email terdaftar dan aktif untuk menerima kode OTP verifikasi keamanan.
            </div>

            <!-- ATURAN 2: Onsubmit di tag HTML memanggil fungsi JS -->
            <form id="formForgotPassword" onsubmit="submitForgotPassword(event)">
                <div class="form-group">
                    <label for="emailInput">Alamat Email Terdaftar</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope"></i>
                        <input id="emailInput" type="email" placeholder="Masukkan email terdaftar" autocomplete="email" value="admin@spk.com" required />
                    </div>
                </div>
                <button type="submit" id="btnSubmit" class="btn">
                    <i class="fas fa-paper-plane"></i> Kirim Kode OTP
                </button>
            </form>

            <div class="back-link">
                <a href="/Account/Login"><i class="fas fa-arrow-left"></i> Kembali ke Halaman Login</a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        function submitForgotPassword(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var email = $('#emailInput').val().trim();
            if (!email) {
                showError('Alamat email wajib diisi.');
                return;
            }

            var $btn = $('#btnSubmit');

            $.ajax({
                url: API_BASE_URL + '/auth/forgot-password',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email
                }),
                beforeSend: function () {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Mengirim OTP...');
                },
                success: function (res) {
                    showSuccess('Kode OTP berhasil dikirim ke email Anda! Mengalihkan ke verifikasi...');
                    setTimeout(function () {
                        window.location.href = '/Account/VerifyOtp?email=' + encodeURIComponent(email);
                    }, 800);
                },
                error: function (xhr) {
                    var msg = 'Gagal mengirim kode OTP. Pastikan email terdaftar di sistem.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Kirim Kode OTP');
                }
            });
        }
    </script>
</body>
</html>
