@{
    ViewData["Title"] = "Masuk ke Sistem";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Masuk - SPK Prioritas Alternatif (Metode SAW)</title>
    <!-- Bootstrap 5 CSS untuk Struktur Dasar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(45, 212, 191, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.12) 0%, transparent 50%),
                radial-gradient(circle at 50% 100%, rgba(13, 148, 136, 0.08) 0%, transparent 40%);
        }
        .login-wrapper { width: 100%; max-width: 420px; position: relative; }
        .login-wrapper::before, .login-wrapper::after {
            content: ''; position: fixed; border-radius: 50%; opacity: 0.07; pointer-events: none; z-index: 0;
        }
        .login-wrapper::before { width: 300px; height: 300px; background: #0d9488; top: -80px; right: -100px; }
        .login-wrapper::after { width: 200px; height: 200px; background: #38bdf8; bottom: -60px; left: -80px; }
        .login-card {
            position: relative; z-index: 1; background: #ffffff; border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px; width: 100%; border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .login-card { padding: 32px 22px 28px; border-radius: 16px; }
        }
        .login-header { text-align: center; margin-bottom: 28px; }
        .login-header .logo {
            width: 68px; height: 68px;
            background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
            border-radius: 18px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 18px; box-shadow: 0 8px 24px rgba(13,148,136,.25);
            transform: rotate(-3deg); transition: transform .3s ease;
        }
        .login-header .logo:hover { transform: rotate(0deg) scale(1.05); }
        .login-header .logo i { font-size: 28px; color: #fff; }
        .login-header h1 { font-size: 21px; color: #0f172a; margin-bottom: 5px; font-weight: 700; letter-spacing: -.02em; }
        .login-header p { color: #64748b; font-size: 13px; line-height: 1.5; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 7px; }
        .input-wrapper { position: relative; }
        .input-wrapper i.fi { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 15px; transition: color .2s; }
        .input-wrapper:focus-within i.fi { color: #0d9488; }
        .toggle-pwd {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            color: #94a3b8; cursor: pointer; font-size: 15px; background: none; border: none; padding: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .toggle-pwd:hover { color: #0d9488; }
        .form-group input[type=email], .form-group input[type=password], .form-group input[type=text] {
            width: 100%; padding: 12px 40px 12px 42px; border: 1.5px solid #e2e8f0;
            border-radius: 12px; font-size: 14px; color: #1e293b; background: #f8fafc;
            transition: all .2s; outline: none;
        }
        .form-group input:focus { border-color: #2dd4bf; background: #fff; box-shadow: 0 0 0 3px rgba(45,212,191,.15); }
        .form-group input::placeholder { color: #94a3b8; }
        .form-check { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
        .form-check input { width: auto; padding: 0; accent-color: #0d9488; cursor: pointer; }
        .form-check label { font-size: 13px; color: #64748b; font-weight: 400; margin: 0; cursor: pointer; }
        .forgot-link { text-align: right; margin-bottom: 18px; }
        .forgot-link a { color: #0d9488; font-size: 12.5px; text-decoration: none; font-weight: 500; }
        .forgot-link a:hover { text-decoration: underline; }
        .btn-login {
            width: 100%; padding: 13px; background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
            color: white; border: none; border-radius: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; transition: all .25s; display: flex; align-items: center;
            justify-content: center; gap: 8px; margin-top: 4px;
            box-shadow: 0 4px 14px rgba(13,148,136,.3);
        }
        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(13,148,136,.4); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: 0.7; cursor: not-allowed; }
        .error-msg {
            background: #fef2f2; color: #dc2626; padding: 11px 14px;
            border-radius: 10px; font-size: 13px; margin-bottom: 16px;
            border: 1px solid #fecaca; display: flex; align-items: center; gap: 8px;
        }
        .success-msg {
            background: #f0fdf4; color: #166534; padding: 11px 14px;
            border-radius: 10px; font-size: 13px; margin-bottom: 16px;
            border: 1px solid #bbf7d0; display: flex; align-items: center; gap: 8px;
        }
        .demo-box {
            margin-top: 20px; padding: 12px 14px; background: #f8fafc; border: 1px dashed #cbd5e1;
            border-radius: 12px; font-size: 12px; color: #64748b;
        }
        .demo-box-head {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;
            font-weight: 600; color: #334155;
        }
        .demo-btn {
            background: #e2e8f0; border: none; border-radius: 6px; padding: 3px 8px; font-size: 11px;
            color: #0f172a; cursor: pointer; font-weight: 600; transition: background .2s;
        }
        .demo-btn:hover { background: #cbd5e1; }
        .login-footer { text-align: center; margin-top: 22px; font-size: 12px; color: #94a3b8; }
    </style>
</head>
<body>
    <!-- ATURAN: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-3 py-4 position-relative min-vh-100 d-flex align-items-center justify-content-center w-100">
        <div class="login-wrapper">
            <div class="login-card">
                <div class="login-header">
                    <div class="logo"><i class="fas fa-ranking-star"></i></div>
                    <h1>SPK SAW Prioritas</h1>
                    <p>Sistem Pendukung Keputusan Penentuan Prioritas Alternatif Terbaik Menggunakan Metode Simple Additive Weighting (SAW)</p>
                </div>

                <div id="alertArea"></div>

                <!-- Onsubmit di tag HTML memanggil fungsi JS -->
                <form id="formLogin" onsubmit="submitLogin(event)">
                    <div class="form-group">
                        <label for="emailInput">Alamat Email</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope fi"></i>
                            <input id="emailInput" type="email" placeholder="Masukkan email terdaftar" autocomplete="email" value="tijartaufikr2@gmail.com" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="pwdInput">Kata Sandi</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock fi"></i>
                            <input id="pwdInput" type="password" placeholder="Masukkan kata sandi" autocomplete="current-password" value="Admin123!" required />
                            <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('pwdInput', this)" title="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
                        <div class="form-check">
                            <input type="checkbox" id="rememberMe" checked />
                            <label for="rememberMe">Ingat saya</label>
                        </div>
                        <div class="forgot-link" style="margin:0;">
                            <a href="/Account/ForgotPassword">Lupa kata sandi?</a>
                        </div>
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-login">
                        <i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Sistem
                    </button>

                    <!-- Akses Demo Singkat -->
                    <div class="demo-box">
                        <div class="demo-box-head">
                            <span><i class="fas fa-user-shield text-teal me-1"></i> Akun Pengujian:</span>
                            <button type="button" class="demo-btn" onclick="fillAdminDemo()">Gunakan</button>
                        </div>
                        <div>Email: <b>tijartaufikr2@gmail.com</b> &bull; Sandi: <b>Admin123!</b></div>
                    </div>

                    <div class="login-footer">SPK Prioritas Alternatif &copy; @DateTime.UtcNow.Year</div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        function fillAdminDemo() {
            $('#emailInput').val('tijartaufikr2@gmail.com');
            $('#pwdInput').val('Admin123!');
        }

        function togglePasswordVisibility(id, btn) {
            var $input = $('#' + id);
            var $icon = $(btn).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.attr('class', 'fas fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.attr('class', 'fas fa-eye');
            }
        }

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        function submitLogin(e) {
            e.preventDefault();
            $('#alertArea').empty();
            var $btn = $('#btnSubmit');

            var email = $('#emailInput').val().trim();
            var password = $('#pwdInput').val();
            var rememberMe = $('#rememberMe').is(':checked');

            if (!email || !password) {
                showError('Email dan kata sandi wajib diisi.');
                return;
            }

            $.ajax({
                url: API_BASE_URL + '/auth/login',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email,
                    password: password,
                    rememberMe: rememberMe
                }),
                beforeSend: function () {
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memverifikasi...');
                },
                success: function (res) {
                    if (res.success && res.user) {
                        showSuccess('Login berhasil! Mengalihkan ke dashboard...');
                        if (window.AuthSession && typeof window.AuthSession.setToken === 'function') {
                            window.AuthSession.setToken(res.token);
                        } else if (res.token) {
                            localStorage.setItem('jwtToken', res.token);
                        }
                        if (window.AuthSession && typeof window.AuthSession.setUser === 'function') {
                            window.AuthSession.setUser(res.user);
                        } else if (res.user) {
                            localStorage.setItem('currentUser', JSON.stringify(res.user));
                        }

                        setTimeout(function () {
                            window.location.href = '/Dashboard/Index';
                        }, 500);
                    } else {
                        showError(res.message || 'Login gagal.');
                        $btn.prop('disabled', false).html('<i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Sistem');
                    }
                },
                error: function (xhr) {
                    var msg = 'Email atau kata sandi tidak sesuai. Silakan periksa kembali.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Sistem');
                }
            });
        }

        $(function () {
            // Auto-redirect jika token masih valid
            if (window.AuthSession && typeof window.AuthSession.isAuthenticated === 'function' && window.AuthSession.isAuthenticated()) {
                window.location.href = '/Dashboard/Index';
            }
        });
    </script>
</body>
</html>
