@{
    ViewData["Title"] = "Halaman Depan";
}

<!-- ATURAN 1: Tag pembungkus paling awal di file konten wajib diawali <div class="row ..."> -->
<div class="row">
    <div class="col-12 mb-3">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-home" style="color:#0f766e;margin-right:.45rem;"></i>Selamat Datang</h3>
            </div>
            <div class="card-body">
                <p style="color:#64748b;font-size:.9rem;line-height:1.8;">
                    Selamat datang di <strong>Sistem Pendukung Keputusan Penentuan Prioritas Alternatif Terbaik</strong>.<br>
                    Anda login sebagai <strong>@(User.Identity?.Name ?? "Pengguna")</strong>.
                </p>
                <div class="dash-actions" style="margin-top:1.5rem;">
                    <a href="/Dashboard/Index" class="dash-action" style="text-decoration:none;">
                        <i class="fas fa-chart-pie"></i>
                        <span><strong>Dashboard SPK</strong><small>Lihat ringkasan dan statistik</small></span>
                    </a>
                    <a href="/Keputusan/Index" class="dash-action" style="text-decoration:none;">
                        <i class="fas fa-scale-balanced"></i>
                        <span><strong>Penentuan Prioritas</strong><small>Proses evaluasi prioritas alternatif</small></span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-3">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-circle-info" style="color:#0f766e;margin-right:.45rem;"></i>Info Sistem</h3>
            </div>
            <div class="card-body">
                <p style="color:#64748b;font-size:.85rem;">
                    Sistem Pendukung Keputusan (SPK) ini dirancang untuk membantu penentuan prioritas alternatif terbaik secara objektif, transparan, dan terstruktur berbasis evaluasi multi-kriteria.
                </p>
            </div>
        </div>
    </div>
</div>
