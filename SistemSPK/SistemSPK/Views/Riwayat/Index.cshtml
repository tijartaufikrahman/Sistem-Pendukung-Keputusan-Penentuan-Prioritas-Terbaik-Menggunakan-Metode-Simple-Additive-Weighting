@{
    ViewData["Title"] = "Riwayat Evaluasi Keputusan";
}

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printSection, #printSection * {
            visibility: visible;
        }
        #printSection {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 20px;
            background: #ffffff;
            color: #000000;
        }
        .no-print, .sidebar, .topbar, .btn, .admin-modal-backdrop, .content-breadcrumb-bar {
            display: none !important;
        }
    }
    .print-header-box {
        border-bottom: 2px solid #0f172a;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }
    .signature-box {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        page-break-inside: avoid;
    }
    .signature-col {
        width: 220px;
        text-align: center;
    }
    /* Enhanced Table styling for History */
    #tableRiwayat thead th {
        background-color: #f1f5f9 !important;
        color: #0f172a !important;
        font-weight: 700 !important;
        font-size: 13px !important;
        letter-spacing: 0.3px !important;
        padding: 12px 14px !important;
        border-bottom: 2px solid #cbd5e1 !important;
        vertical-align: middle !important;
    }
    #tableRiwayat tbody td {
        padding: 11px 14px !important;
        color: #0f172a !important;
        font-size: 13.5px !important;
        border-bottom: 1px solid #e2e8f0 !important;
        vertical-align: middle !important;
    }
    #tableRiwayat tbody tr:hover td {
        background-color: #f8fafc !important;
    }
    .code-tag {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12.5px;
        font-weight: 700;
        background: #e2e8f0;
        color: #0f172a;
        padding: 3px 8px;
        border-radius: 5px;
        border: 1px solid #cbd5e1;
        display: inline-block;
        white-space: nowrap !important;
        text-wrap: nowrap !important;
        word-break: keep-all !important;
    }
    .btn-act {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        font-size: 13px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .btn-act:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .btn-act-view {
        color: #0284c7;
        border-color: #bae6fd;
        background: #f0f9ff;
    }
    .btn-act-view:hover {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #7dd3fc;
    }
    .btn-act-del {
        color: #dc2626;
        border-color: #fecaca;
        background: #fef2f2;
    }
    .btn-act-del:hover {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fca5a5;
    }
</style>

<div class="row">
    <div class="col-12">

        <!-- Breadcrumb Bar -->
        <div class="content-breadcrumb-bar mb-2 no-print">
            <div class="breadcrumb-nav" id="pageBreadcrumb">
                <span class="breadcrumb-current">Riwayat Evaluasi Keputusan</span>
                <span class="breadcrumb-separator">/</span>
            </div>
        </div>

        <!-- Admin Table Card -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <div>
                    <h3 class="admin-card-title">Arsip Riwayat Evaluasi Keputusan</h3>
                    <p class="admin-card-desc">Daftar seluruh kegiatan evaluasi keputusan penentuan prioritas alternatif yang telah disahkan beserta rekam jejak penilaian</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle w-100" id="tableRiwayat" style="font-size:12.5px;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 45px; text-align:center;">NO</th>
                            <th style="width: 170px; min-width: 170px; white-space: nowrap;" class="text-nowrap">KODE EVALUASI</th>
                            <th style="min-width: 220px;">NAMA KEGIATAN EVALUASI</th>
                            <th style="min-width: 260px;">KETERANGAN EVALUASI</th>
                            <th style="width: 130px; white-space: nowrap;">TANGGAL EVALUASI</th>
                            <th class="text-center" style="width: 110px;">SKOR TERTINGGI</th>
                            <th class="text-center" style="width: 110px;">KANDIDAT ALTERNATIF</th>
                            <th class="text-center" style="width: 90px;">STATUS</th>
                            <th style="text-align: right; width: 110px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="tableRiwayatBody">
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>


<!-- TEMPLATE LEMBAR CETAK REKOMENDASI (PRINT ONLY) -->
<div id="printSection" style="display:none;">
    <div class="print-header-box text-center">
        <h2 style="font-size:18px; font-weight:800; text-transform:uppercase; margin-bottom:2px; letter-spacing:0.5px;">
            SISTEM PENDUKUNG KEPUTUSAN PENENTUAN PRIORITAS ALTERNATIF TERBAIK MENGGUNAKAN METODE SIMPLE ADDITIVE WEIGHTING (SAW)
        </h2>
        <p style="font-size:12px; margin-bottom:0; color:#334155;">
            LEMBAR REKOMENDASI DAN PENETAPAN PRIORITAS ALTERNATIF TERBAIK
        </p>
    </div>

    <table style="width:100%; font-size:12px; margin-bottom:18px; border-collapse:collapse;">
        <tr>
            <td style="width:160px; font-weight:bold; padding:4px 0;">Nomor Dokumen Evaluasi:</td>
            <td id="printKode" style="padding:4px 0;">-</td>
            <td style="width:140px; font-weight:bold; padding:4px 0;">Tanggal Evaluasi:</td>
            <td id="printTanggal" style="padding:4px 0;">-</td>
        </tr>
        <tr>
            <td style="font-weight:bold; padding:4px 0;">Nama Kegiatan Evaluasi:</td>
            <td colspan="3" id="printNama" style="padding:4px 0; font-weight:bold; color:#0f766e;">-</td>
        </tr>
        <tr>
            <td style="font-weight:bold; padding:4px 0;">Keterangan / Tujuan:</td>
            <td colspan="3" id="printKeterangan" style="padding:4px 0;">-</td>
        </tr>
    </table>

    <div style="background:#f8fafc; border:1px solid #cbd5e1; padding:12px 16px; margin-bottom:20px; border-radius:6px;">
        <span style="font-size:11px; font-weight:bold; text-transform:uppercase; color:#0f766e; display:block; margin-bottom:2px;">
            Hasil Rekomendasi Kandidat Alternatif Terbaik (Prioritas 1):
        </span>
        <div style="font-size:15px; font-weight:bold; color:#0f172a;" id="printPemenangNama">-</div>
        <div style="font-size:12px; color:#475569;" id="printPemenangSkor">Skor Akhir Evaluasi: -</div>
    </div>

    <h4 style="font-size:13px; font-weight:bold; margin-bottom:8px; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">
        Rekapitulasi Peringkat Seluruh Kandidat Alternatif
    </h4>
    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-bottom:24px;" border="1" cellpadding="6">
        <thead style="background:#f1f5f9;">
            <tr>
                <th style="width:45px; text-align:center;">Rank</th>
                <th>Kode</th>
                <th>Nama Kandidat Alternatif</th>
                <th style="text-align:center;">Skor Akhir Evaluasi</th>
                <th style="text-align:center;">Status Rekomendasi</th>
            </tr>
        </thead>
        <tbody id="printRankingBody"></tbody>
    </table>

    <!-- Tanda Tangan Pengesahan -->
    <div class="signature-box">
        <div class="signature-col">
            <span style="font-size:11px;">Diusulkan oleh,</span><br>
            <strong style="font-size:11.5px;">Tim Analis / Penilai</strong>
            <div class="signature-space"></div>
            <div style="border-top:1px solid #000; font-weight:bold; font-size:11.5px; padding-top:4px;">
                ( .................................................. )
            </div>
        </div>

        <div class="signature-col">
            <span style="font-size:11px;">Disahkan oleh,</span><br>
            <strong style="font-size:11.5px;">Tim Pengambil Keputusan</strong>
            <div class="signature-space"></div>
            <div style="border-top:1px solid #000; font-weight:bold; font-size:11.5px; padding-top:4px;">
                ( .................................................. )
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var dtRiwayat = null;
    var allRiwayat = [];
    var currentDetailData = null;

    $(function () {
        loadRiwayatTable();
    });

    function loadRiwayatTable() {
        if (dtRiwayat) {
            dtRiwayat.destroy();
            dtRiwayat = null;
        }
        $('#tableRiwayatBody').empty();

        $.ajax({
            url: API_BASE_URL + '/keputusans?status=Selesai',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Hanya kegiatan evaluasi keputusan yang sudah selesai dihitung dan disimpan yang masuk ke Riwayat
                allRiwayat = (data || []).filter(function (k) {
                    return k.status === 'Selesai';
                });
                var html = '';

                if (allRiwayat.length > 0) {
                    for (var i = 0; i < allRiwayat.length; i++) {
                        var k = allRiwayat[i];
                        var tgl = k.tanggalKeputusan ? new Date(k.tanggalKeputusan).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) : '-';
                        var skor = k.skorTertinggi ? Number(k.skorTertinggi).toFixed(4) : '-';

                        html += '<tr>' +
                            '<td class="text-center fw-bold" style="color:#0f172a; font-size:13.5px;">' + (i + 1) + '</td>' +
                            '<td class="text-nowrap" style="white-space:nowrap;"><span class="code-tag">' + escHtml(k.kodeKeputusan) + '</span></td>' +
                            '<td>' +
                                '<a href="/Riwayat/Detail?id=' + k.id + '" class="fw-bold text-decoration-none" style="color:#0f172a; font-size:13.5px;" title="Lihat Detail Evaluasi Keputusan">' + escHtml(k.namaKeputusan) + '</a>' +
                            '</td>' +
                            '<td>' +
                                '<span style="font-size:12.5px; color:#475569; line-height:1.45;">' + escHtml(k.keterangan || '-') + '</span>' +
                            '</td>' +
                            '<td style="color:#0f172a; font-weight:600; font-size:13px; white-space:nowrap;">' + tgl + '</td>' +
                            '<td class="text-center font-monospace fw-bold" style="font-size:14.5px; color:#0f766e;">' + skor + '</td>' +
                            '<td class="text-center"><span class="badge border font-monospace" style="background:#f1f5f9; color:#0f172a; border-color:#cbd5e1; font-size:12px; font-weight:600; padding:4px 8px;">' + k.jumlahSupplier + ' Kandidat</span></td>' +
                            '<td class="text-center"><span class="status-pill pill-active" style="font-size:12px; font-weight:700; background:#dcfce7; color:#15803d; border-color:#86efac; padding:3px 10px;"><span class="dot-indicator" style="background:#16a34a;"></span>Selesai</span></td>' +
                            '<td class="text-end text-nowrap">' +
                                '<div style="display:flex; gap:6px; justify-content:flex-end; align-items:center;">' +
                                    '<a href="/Riwayat/Detail?id=' + k.id + '" class="btn-act btn-act-view" title="Lihat Detail Evaluasi Keputusan"><i class="fas fa-eye"></i></a>' +
                                    '<button type="button" class="btn-act btn-act-view" title="Cetak Lembar Rekomendasi" onclick="cetakLangsung(\'' + k.id + '\')"><i class="fas fa-print"></i></button>' +
                                    '<button type="button" class="btn-act btn-act-del" title="Hapus Riwayat Evaluasi" onclick="confirmDeleteRiwayat(\'' + k.id + '\', \'' + escHtml(k.namaKeputusan).replace(/'/g, "\\'") + '\')"><i class="fas fa-trash"></i></button>' +
                                '</div>' +
                            '</td>' +
                            '</tr>';
                    }
                    $('#tableRiwayatBody').html(html);
                } else {
                    $('#tableRiwayatBody').empty();
                }

                dtRiwayat = $('#tableRiwayat').DataTable({
                    pageLength: 10,
                    lengthMenu: window.dtLengthMenuConfig,
                    language: $.extend({}, window.dtLanguageConfig, {
                        emptyTable: "Belum ada riwayat kegiatan evaluasi keputusan yang telah dihitung dan disimpan.",
                        zeroRecords: "Data tidak ditemukan"
                    })
                });
            },
            error: function () {
                $('#tableRiwayatBody').empty();
                dtRiwayat = $('#tableRiwayat').DataTable({
                    pageLength: 10,
                    lengthMenu: window.dtLengthMenuConfig,
                    language: $.extend({}, window.dtLanguageConfig, {
                        emptyTable: "Gagal memuat arsip riwayat evaluasi keputusan dari server.",
                        zeroRecords: "Data tidak ditemukan"
                    })
                });
            }
        });
    }

    function cetakLangsung(id) {
        $.ajax({
            url: API_BASE_URL + '/keputusans/' + id,
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (!data) return;
                populatePrintSection(data);
                window.print();
            }
        });
    }

    function cetakLembarDariModal() {
        if (!currentDetailData) return;
        populatePrintSection(currentDetailData);
        window.print();
    }

    function populatePrintSection(data) {
        var tgl = data.tanggalKeputusan ? new Date(data.tanggalKeputusan).toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' }) : '-';

        $('#printKode').text(data.kodeKeputusan);
        $('#printTanggal').text(tgl);
        $('#printNama').text(data.namaKeputusan);
        $('#printKeterangan').text(data.keterangan || '-');
        $('#printPemenangNama').text(data.namaSupplierPemenang || '-');
        $('#printPemenangSkor').text('Skor Akhir Evaluasi: ' + (data.skorTertinggi ? Number(data.skorTertinggi).toFixed(4) : '-'));

        var details = data.details || [];
        var html = '';
        for (var i = 0; i < details.length; i++) {
            var d = details[i];
            html += '<tr>' +
                '<td style="text-align:center;">' + d.peringkat + '</td>' +
                '<td>' + escHtml(d.kodeSupplier) + '</td>' +
                '<td><strong>' + escHtml(d.namaSupplier) + '</strong></td>' +
                '<td style="text-align:center; font-family:monospace; font-weight:bold;">' + Number(d.skorAkhir).toFixed(4) + '</td>' +
                '<td style="text-align:center;">' + escHtml(d.statusRekomendasi) + '</td>' +
                '</tr>';
        }
        $('#printRankingBody').html(html);
        $('#printSection').show();
    }

    function confirmDeleteRiwayat(id, nama) {
        Swal.fire({
            title: 'Hapus Arsip Evaluasi Keputusan?',
            text: 'Apakah Anda yakin ingin menghapus arsip evaluasi keputusan "' + nama + '"? Tindakan ini permanen.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Ya, Hapus Arsip',
            cancelButtonText: 'Batal'
        }).then(function (res) {
            if (res.isConfirmed) {
                $.ajax({
                    url: API_BASE_URL + '/keputusans/' + id,
                    type: 'DELETE',
                    dataType: 'json',
                    success: function (res) {
                        AdminToast.success(res.message || 'Arsip evaluasi keputusan berhasil dihapus');
                        loadRiwayatTable();
                    },
                    error: function (xhr) {
                        var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Gagal menghapus riwayat evaluasi keputusan.';
                        Swal.fire('Gagal', msg, 'error');
                    }
                });
            }
        });
    }
</script>
}
