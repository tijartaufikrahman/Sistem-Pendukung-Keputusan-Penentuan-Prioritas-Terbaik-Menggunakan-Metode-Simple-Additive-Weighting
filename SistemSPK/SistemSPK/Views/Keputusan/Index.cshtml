    function openEditSupplierModal(id) {
        var sup = activeSuppliers.find(function (s) { return s.id === id; });
        if (!sup) return;

        clearSupplierModalErrors();
        $('#editSupplierId').val(sup.id);
        $('#modalTitleSupplier').text('Edit Kandidat Alternatif');
        $('#mNamaSupplier').val(sup.nama);

        $('#modalOverlaySupplier').css('display', 'flex');
        $('#mNamaSupplier').focus();
    }

    function closeSupplierModal() {
        $('#modalOverlaySupplier').hide();
    }

    function closeSupplierModalOverlay(ev) {
        if (ev && ev.target === $('#modalOverlaySupplier')[0]) {
            closeSupplierModal();
        }
    }

    function clearSupplierModalErrors() {
        $('#mErrNamaSupplier').text('');
    }

    function saveSupplierFromModal() {
        clearSupplierModalErrors();
        var editId = $('#editSupplierId').val();
        var nama = $('#mNamaSupplier').val().trim();

        if (!nama) {
            $('#mErrNamaSupplier').text('Nama kandidat alternatif wajib diisi.');
            $('#mNamaSupplier').focus();
            return;
        }

        var isDuplicate = activeSuppliers.some(function (s) {
            return s.nama.toLowerCase() === nama.toLowerCase() && s.id !== editId;
        });
        if (isDuplicate) {
            $('#mErrNamaSupplier').text('Nama kandidat alternatif sudah terdaftar pada kegiatan ini.');
            return;
        }

        var $btn = $('#btnSaveSupplier');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Menyimpan ke DB...');

        if (editId) {
            var isGuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(editId);
            if (isGuid) {
                $.ajax({
                    url: API_BASE_URL + '/suppliers/' + editId,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ namaSupplier: nama, status: "Aktif" }),
                    dataType: 'json',
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Alternatif');
                        var sup = activeSuppliers.find(function (s) { return s.id === editId; });
                        if (sup) {
                            sup.nama = nama;
                        }
                        closeSupplierModal();
                        renderTableSupplier();
                        renderMatriksPenilaian();
                        simpanDrafKeputusan(true);
                        if (window.AdminToast) AdminToast.success('Data kandidat alternatif berhasil diperbarui.');
                    }
                });
            } else {
                $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Alternatif');
                var sup = activeSuppliers.find(function (s) { return s.id === editId; });
                if (sup) {
                    sup.nama = nama;
                }
                closeSupplierModal();
                renderTableSupplier();
                renderMatriksPenilaian();
                simpanDrafKeputusan(true);
            }
        } else {
            // Tambah supplier baru ke database
            $.ajax({
                url: API_BASE_URL + '/suppliers',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    namaSupplier: nama,
                    status: "Aktif"
                }),
                dataType: 'json',
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Alternatif');
                    var newSup = res.data || {};
                    activeSuppliers.push({
                        id: newSup.id || ('temp_' + Math.random().toString(36).substring(2, 9)),
                        kode: newSup.kodeSupplier || ('SPL-' + (activeSuppliers.length + 1).toString().padStart(3, '0')),
                        nama: newSup.namaSupplier || nama
                    });

                    closeSupplierModal();
                    renderTableSupplier();
                    renderMatriksPenilaian();

                    // Simpan ke KeputusanDetails di DB
                    simpanDrafKeputusan(true);

                    if (window.AdminToast) AdminToast.success('Kandidat alternatif ' + nama + ' berhasil didaftarkan dan tersimpan.');
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Alternatif');
                    var errMsg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Gagal menyimpan kandidat alternatif.';
                    $('#mErrNamaSupplier').text(errMsg);
                }
            });
        }
    }

