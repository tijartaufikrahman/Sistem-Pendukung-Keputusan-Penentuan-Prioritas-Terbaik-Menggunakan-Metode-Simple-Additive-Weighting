        }
        $('#tbodyMatriksPenilaian').html(bodyHtml);
    }

    // ================================================================
    // 6. PERHITUNGAN PRIORITAS ALTERNATIF
    // ================================================================
    function hitungKeputusan() {
        $('#prosesMsg').hide();

        if (!currentParent || !currentParent.nama) {
            alert('Data kegiatan evaluasi keputusan belum ditentukan.');
            return;
        }

        if (!currentAspekId) {
            showProsesMsg('Silakan pilih aspek penilaian terlebih dahulu pada panel Pengaturan Aspek & Bobot Kriteria.', true);
            return;
        }

        if (activeSuppliers.length < 2) {
            showProsesMsg('Tambahkan minimal 2 kandidat alternatif untuk dibandingkan prioritasnya.', true);
            return;
        }

        if (activeParameters.length < 1) {
            showProsesMsg('Aspek kriteria evaluasi belum memiliki parameter penilaian.', true);
            return;
        }

        var hasEmpty = false;
        $('.cell-input-nilai').each(function () {
            var k = $(this).data('key');
            var val = $(this).val();
            cellValues[k] = val;
            if (val === '' || isNaN(parseFloat(val))) {
                hasEmpty = true;
                return false;
            }
        });

        if (hasEmpty) {
            showProsesMsg('Seluruh nilai pada lembar matriks evaluasi wajib diisi angka riil.', true);
            return;
        }

        var totalBobot = 0;
        for (var i = 0; i < activeParameters.length; i++) {
            totalBobot += (activeParameters[i].bobot || 0);
        }
        totalBobot = Math.round(totalBobot * 10) / 10;
        if (Math.abs(totalBobot - 100) > 0.01) {
            showProsesMsg('Total akumulasi bobot prioritas kriteria harus tepat 100% (saat ini: ' + totalBobot + '%).', true);
            return;
        }

        var directWeights = {};
        for (var i = 0; i < activeParameters.length; i++) {
            var p = activeParameters[i];
            directWeights[p.id] = p.bobot;
        }

        var hasTempSupplier = activeSuppliers.some(function (s) {
            return !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s.id);
        });

        $('#btnHitung').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Menghitung Rekomendasi...');

        if (hasTempSupplier) {
            simpanDrafSebelumHitung(function () {
                eksekusiPerhitungan(directWeights);
            });
        } else {
            eksekusiPerhitungan(directWeights);
        }
    }

    function showProsesMsg(msg, isError) {
        var $el = $('#prosesMsg');
        $el.text(msg).attr('class', isError ? 'msg-error' : 'msg-info').show();
        $('html, body').animate({ scrollTop: $('#cardLembarPenilaian').offset().top - 20 }, 'smooth');
    }

    function simpanDrafSebelumHitung(callback) {
        var nama = currentParent.nama;
        var tgl = currentParent.tanggal;
        var catatan = currentParent.catatan;

        var details = activeSuppliers.map(function (sup) {
            var isGuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(sup.id);
            return {
                supplierId: isGuid ? sup.id : null,
                namaSupplier: sup.nama,
                statusRekomendasi: "Draft",
                nilais: activeParameters.map(function (p) {
                    var rawVal = cellValues[sup.id + '_' + p.id];
                    return {
                        parameterId: p.id,
                        nilaiRiil: parseFloat(rawVal) || 0
                    };
                })
            };
        });

        $.ajax({
            url: API_BASE_URL + '/keputusans',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                id: currentSessionId || null,
                namaKeputusan: nama,
                tanggalKeputusan: tgl ? new Date(tgl) : new Date(),
                aspekId: currentAspekId,
                keterangan: catatan || null,
                status: "Draft",
                details: details
            }),
            dataType: 'json',
            success: function (res) {
                currentSessionId = res.id;
                currentSessionKode = res.kode;
                $('#dispKodePengadaan').text(res.kode || 'KPTS-DRAFT');
                window.history.replaceState({ id: res.id }, '', window.location.pathname + '?id=' + res.id);

                $.ajax({
                    url: API_BASE_URL + '/keputusans/' + res.id,
                    type: 'GET',
                    dataType: 'json',
                    success: function (freshData) {
                        if (freshData && freshData.details) {
                            activeSuppliers = freshData.details.map(function (d) {
                                return {
                                    id: d.supplierId,
                                    kode: d.kodeSupplier,
                                    nama: d.namaSupplier
                                };
                            });

                            cellValues = {};
                            freshData.details.forEach(function (d) {
                                if (d.nilais) {
                                    d.nilais.forEach(function (n) {
                                        cellValues[d.supplierId + '_' + n.parameterId] = n.nilaiRiil;
                                    });
                                }
                            });
                        }
                        if (typeof callback === 'function') callback();
                    }
                });
            },
            error: function () {
                $('#btnHitung').prop('disabled', false).html('<i class="fas fa-calculator me-1.5"></i> Hitung Rekomendasi Prioritas');
                showProsesMsg('Gagal menyinkronkan data kandidat alternatif ke database.', true);
            }
        });
    }

    function eksekusiPerhitungan(directWeights) {
        var nilaiInputs = [];
        for (var s = 0; s < activeSuppliers.length; s++) {
            var sup = activeSuppliers[s];
            for (var p = 0; p < activeParameters.length; p++) {
                var pId = activeParameters[p].id;
                var val = parseFloat(cellValues[sup.id + '_' + pId]) || 0;
                nilaiInputs.push({
                    supplierId: sup.id,
                    parameterId: pId,
                    nilaiRiil: val
                });
            }
        }

        var payload = {
            namaKeputusan: currentParent.nama,
            supplierIds: activeSuppliers.map(function (s) { return s.id; }),
            parameterIds: activeParameters.map(function (p) { return p.id; }),
            nilaiInputs: nilaiInputs,
            directWeights: directWeights
        };

        $.ajax({
            url: API_BASE_URL + '/keputusans/calculate',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            dataType: 'json',
            success: function (res) {
                $('#btnHitung').prop('disabled', false).html('<i class="fas fa-calculator me-1.5"></i> Hitung Rekomendasi Prioritas');

                if (res && res.data) {
                    lastCalcResult = res.data;
                    tampilkanHasil(res.data);
                }
            },
            error: function (xhr) {
                $('#btnHitung').prop('disabled', false).html('<i class="fas fa-calculator me-1.5"></i> Hitung Rekomendasi Prioritas');
                var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Gagal melakukan perhitungan.';
                showProsesMsg(msg, true);
            }
        });
    }

    // ================================================================
    // 7. TAMPILKAN HASIL & PERANGKINGAN
    // ================================================================
    function tampilkanHasil(data) {
        var rankings = data.rankings || [];
        if (rankings.length === 0) return;

        var winner = rankings[0];
        $('#resWinnerName').text(winner.namaSupplier).attr('title', winner.namaSupplier);
        $('#resWinnerScore').text(Number(winner.skorAkhir).toFixed(4));
        $('#resWinnerScorePct').text('(' + (Number(winner.skorAkhir) * 100).toFixed(2) + '%)');
        $('#resTotalRekanan').text(rankings.length);

        var asp = allAspeks.find(function (a) { return a.id === currentAspekId; });
        var aspName = asp ? asp.namaAspek : '-';
        $('#resAspekName').text(aspName).attr('title', aspName);
        $('#resCountKriteria').text(activeParameters.length + ' Parameter Evaluasi');

        // Tabel Rekapitulasi Peringkat
        var rankHtml = '';
        for (var i = 0; i < rankings.length; i++) {
            var r = rankings[i];
            var rankBadge = (r.peringkat === 1)
                ? '<span class="badge bg-warning text-dark px-2.5 py-1 fs-6">1</span>'
                : (r.peringkat === 2
                    ? '<span class="badge bg-secondary text-white px-2.5 py-1">2</span>'
                    : '<span class="badge bg-light text-dark border px-2.5 py-1">' + r.peringkat + '</span>');

            var statusBadge = (r.peringkat === 1)
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold"><i class="fas fa-check-circle me-1"></i> Pilihan Utama</span>'
                : (r.peringkat === 2
                    ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">Alternatif Cadangan</span>'
                    : '<span class="badge bg-light text-muted border px-2 py-1">' + esc(r.statusRekomendasi) + '</span>');

            rankHtml += '<tr>' +
                '<td class="tc">' + rankBadge + '</td>' +
                '<td><strong style="color:#0f172a; font-size:13px;">' + esc(r.kodeSupplier) + '</strong></td>' +
                '<td><strong style="color:#0f172a; font-size:13px;">' + esc(r.namaSupplier) + '</strong></td>' +
                '<td class="tc font-monospace result-col" style="font-size:13.5px;">' + Number(r.skorAkhir).toFixed(4) + '</td>' +
                '<td class="tc">' + statusBadge + '</td>' +
            '</tr>';
        }
        $('#tableRankingBody').html(rankHtml);

        // Tabel Rincian Nilai Parameter
        renderDetailParamResult(data);

        $('#cardHasil').fadeIn(300);

        $('html, body').animate({
            scrollTop: $('#cardHasil').offset().top - 30
        }, 500);

        if (window.AdminToast) AdminToast.success('Perhitungan selesai! Rekomendasi prioritas telah dihasilkan.');
    }

    function renderDetailParamResult(data) {
        var rankings = data.rankings || [];
        var paramWeights = data.parameterWeights || [];

        var thead = '<tr>';
        thead += '<th style="width:75px;" class="tc">RANK</th>';
        thead += '<th style="min-width:180px; text-align:left;">NAMA KANDIDAT ALTERNATIF</th>';

        for (var p = 0; p < activeParameters.length; p++) {
            var param = activeParameters[p];
            var pw = paramWeights.find(function (w) { return w.parameterId === param.id; });
            var persenBobot = pw ? pw.persentase : param.bobot;
            var sifatBadge = param.sifat === 'Cost'
                ? '<span class="pill-cost"><i class="fas fa-arrow-down"></i> Cost</span>'
                : '<span class="pill-benefit"><i class="fas fa-arrow-up"></i> Benefit</span>';

            thead += '<th style="min-width:140px;" class="tc">' +
                '<div class="fw-bold text-dark text-truncate" title="' + esc(param.nama) + '" style="font-size:11.5px;">' + esc(param.nama) + '</div>' +
                '<div class="d-flex justify-content-center align-items-center gap-1 mt-0.5">' +
                    '<small class="text-muted">' + (param.satuan ? esc(param.satuan) + ' • ' : '') + '</small>' +
                    sifatBadge +
                '</div>' +
                '<div class="mt-1 badge bg-light text-teal border border-teal-subtle" style="font-size:9.5px;">Bobot: ' + persenBobot + '%</div>' +
            '</th>';
        }

        thead += '<th style="width:105px;" class="tc result-col">SKOR AKHIR</th>';
        thead += '</tr>';
        $('#tableDetailHead').html(thead);

        var tbody = '';
        for (var i = 0; i < rankings.length; i++) {
            var r = rankings[i];
            var isPemenang = (r.peringkat === 1);

            tbody += '<tr style="' + (isPemenang ? 'background:rgba(240, 253, 250, 0.6);' : '') + '">';
            tbody += '<td class="tc">' +
                (isPemenang
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-2.5 py-1">1</span>'
                    : '<span class="badge bg-light text-dark border px-2.5 py-1">' + r.peringkat + '</span>') +
            '</td>';
            tbody += '<td class="prog-name">' +
                '<strong style="color:#0f172a;">' + esc(r.namaSupplier) + '</strong>' +
            '</td>';

            for (var p = 0; p < activeParameters.length; p++) {
                var pId = activeParameters[p].id;
                var param = activeParameters[p];

                var rawVal = (r.realValues && r.realValues[pId] !== undefined)
                    ? Number(r.realValues[pId])
                    : (cellValues[r.supplierId + '_' + pId] ? Number(cellValues[r.supplierId + '_' + pId]) : 0);

                var normScore = (r.normalizedScores && r.normalizedScores[pId] !== undefined)
                    ? Number(r.normalizedScores[pId])
                    : 0;

                var normPersen = (normScore * 100).toFixed(1);
                var kontribusi = (normScore * (param.bobot || 0)).toFixed(2);

                tbody += '<td class="p-1.5 text-center">' +
                    '<div class="font-monospace fw-bold text-dark" style="font-size:11.5px;">' +
                        rawVal.toLocaleString('id-ID') + (param.satuan ? ' <small class="text-muted fw-normal">' + esc(param.satuan) + '</small>' : '') +
                    '</div>' +
                    '<div class="d-flex justify-content-center align-items-center gap-1 mt-1">' +
                        '<span class="badge" style="background:#e0f2fe; color:#0369a1; font-size:9.5px; font-weight:600;" title="Nilai Normalisasi">' +
                            normPersen + '%' +
                        '</span>' +
                        '<span class="badge" style="background:#dcfce7; color:#15803d; font-size:9.5px; font-weight:600;" title="Poin Kontribusi Terbobot">' +
                            '+' + kontribusi + '% pts' +
                        '</span>' +
                    '</div>' +
                '</td>';
            }

            var skorPersen = (Number(r.skorAkhir) * 100).toFixed(2);
            tbody += '<td class="tc font-monospace fw-bold result-col" style="font-size:13.5px;">' +
                Number(r.skorAkhir).toFixed(4) +
                '<div style="font-size:10px; color:#059669;">(' + skorPersen + '%)</div>' +
            '</td>';
            tbody += '</tr>';
        }

        $('#tableDetailBody').html(tbody);
    }

    function kembaliKePenilaian() {
        $('html, body').animate({
            scrollTop: $('#cardLembarPenilaian').offset().top - 20
        }, 400);
    }

    // ================================================================
    // 8. SIMPAN DRAF & SIMPAN HASIL FINAL KE RIWAYAT
    // ================================================================
    function simpanDrafKeputusan(silent, callback) {
        if (!currentParent) {
            if (callback) callback();
            return;
        }
        var nama = currentParent.nama;
        var tgl = currentParent.tanggal;
        var catatan = currentParent.catatan;

        $('.cell-input-nilai').each(function () {
            var k = $(this).data('key');
            var val = $(this).val();
            if (val !== undefined && val !== '') {
                cellValues[k] = val;
            }
        });

        var details = activeSuppliers.map(function (sup) {
            var isGuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(sup.id);
            return {
                supplierId: isGuid ? sup.id : null,
                namaSupplier: sup.nama,
                statusRekomendasi: "Draft",
                nilais: activeParameters.map(function (p) {
                    var rawVal = cellValues[sup.id + '_' + p.id];
                    var parsed = parseFloat(rawVal);
                    return {
                        parameterId: p.id,
                        nilaiRiil: isNaN(parsed) ? 0 : parsed
                    };
                })
            };
        });

        $.ajax({
            url: API_BASE_URL + '/keputusans',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                id: currentSessionId || null,
                kodeKeputusan: currentSessionKode || null,
                namaKeputusan: nama,
                tanggalKeputusan: tgl ? new Date(tgl) : new Date(),
                aspekId: currentAspekId,
                keterangan: catatan || null,
                status: "Draft",
                details: details
            }),
            dataType: 'json',
            success: function (res) {
                currentSessionId = res.id;
                currentSessionKode = res.kode;
                $('#dispKodePengadaan').text(res.kode || 'KPTS-DRAFT');
                localStorage.setItem('activePengadaanId', res.id);
                window.history.replaceState({ id: res.id }, '', window.location.pathname + '?id=' + res.id);

                // Update item di allDraftKeputusans
                var draftItem = allDraftKeputusans.find(function (d) { return d.id === res.id; });
                if (draftItem) {
                    draftItem.jumlahSupplier = activeSuppliers.length;
                    draftItem.namaKeputusan = nama;
                    var asp = allAspeks.find(function (a) { return a.id === currentAspekId; });
                    if (asp) draftItem.namaAspek = asp.namaAspek;
                    renderDaftarDraftPengadaan();
                }

                if (!silent) {
                    if (window.AdminToast) AdminToast.success('Draf evaluasi keputusan berhasil disimpan ke database.');
                    else Swal.fire('Tersimpan', 'Draf evaluasi keputusan berhasil disimpan.', 'success');
                }
                if (callback) callback(null, res);
            },
            error: function (xhr) {
                if (!silent) {
                    Swal.fire('Gagal', 'Gagal menyimpan draf.', 'error');
                }
                if (callback) callback(xhr);
            }
        });
    }

    var autoSaveCellTimer = null;
    $(document).on('input change', '.cell-input-nilai', function () {
        var k = $(this).data('key');
        var val = $(this).val();
        cellValues[k] = val;

        clearTimeout(autoSaveCellTimer);
        autoSaveCellTimer = setTimeout(function () {
            simpanDrafKeputusan(true);
        }, 800);
    });

    function simpanHasilKeHistory() {
        if (!lastCalcResult || !lastCalcResult.rankings || lastCalcResult.rankings.length === 0) {
            Swal.fire('Peringatan', 'Lakukan perhitungan terlebih dahulu.', 'warning');
            return;
        }

        var nama = currentParent.nama;
        var tgl = currentParent.tanggal;
        var catatan = currentParent.catatan;
        var winner = lastCalcResult.rankings[0];

        var details = [];
        for (var i = 0; i < lastCalcResult.rankings.length; i++) {
            var r = lastCalcResult.rankings[i];
            var nilaiList = [];

            for (var p = 0; p < activeParameters.length; p++) {
                var pId = activeParameters[p].id;
                var rawVal = (r.realValues && r.realValues[pId] !== undefined) ? r.realValues[pId] : 0;
                nilaiList.push({
                    parameterId: pId,
                    nilaiRiil: rawVal
                });
            }

            details.push({
                supplierId: r.supplierId,
                skorAkhir: r.skorAkhir,
                peringkat: r.peringkat,
                statusRekomendasi: r.statusRekomendasi,
                catatanEvaluasi: (r.peringkat === 1 ? lastCalcResult.winnerHighlight : null),
                nilais: nilaiList
            });
        }

        var payload = {
            id: currentSessionId || null,
            kodeKeputusan: currentSessionKode || null,
            namaKeputusan: nama,
            tanggalKeputusan: tgl ? new Date(tgl) : new Date(),
            aspekId: currentAspekId,
            keterangan: catatan || null,
            supplierPemenangId: winner.supplierId,
            skorTertinggi: winner.skorAkhir,
            status: "Selesai",
            details: details
        };

        var $btn = $('#btnSimpanHasil');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

        $.ajax({
            url: API_BASE_URL + '/keputusans',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            dataType: 'json',
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Simpan ke Riwayat');
                currentSessionId = res.id;
                currentSessionKode = res.kode;
                $('#dispKodePengadaan').text(res.kode || 'SELESAI');
                localStorage.removeItem('activePengadaanId');

                // Hapus dari list draf karena statusnya sudah Selesai (masuk Riwayat)
                allDraftKeputusans = allDraftKeputusans.filter(function (d) { return d.id !== res.id; });
                renderDaftarDraftPengadaan();

                Swal.fire({
                    title: 'Evaluasi Keputusan Selesai!',
                    text: 'Hasil evaluasi keputusan penentuan prioritas alternatif ' + (res.kode || '') + ' telah tersimpan permanen ke Riwayat Evaluasi Keputusan.',
                    icon: 'success',
                    showCancelButton: true,
                    confirmButtonColor: '#0f766e',
                    confirmButtonText: 'Buka Riwayat',
                    cancelButtonText: 'Tetap di Sini'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        window.location.href = '/Riwayat/Index';
                    }
                });
            },
            error: function (xhr) {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Simpan ke Riwayat');
                var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Gagal menyimpan hasil evaluasi keputusan.';
                Swal.fire('Gagal', msg, 'error');
            }
        });
    }

    // ================================================================
    // 9. HAPUS KEGIATAN EVALUASI & RESET
    // ================================================================
    function hapusDraftPengadaan(id, nama) {
        if (!id) return;
        var displayName = nama || 'ini';
        if (!confirm('Yakin ingin menghapus draf evaluasi keputusan "' + displayName + '"?\nData kandidat alternatif dan matriks penilaian untuk evaluasi ini akan dihapus secara permanen dari database.')) {
            return;
        }

        $.ajax({
            url: API_BASE_URL + '/keputusans/' + id,
            type: 'DELETE',
            success: function () {
                allDraftKeputusans = allDraftKeputusans.filter(function (d) { return d.id !== id; });

                if (currentSessionId === id) {
                    if (allDraftKeputusans.length > 0) {
                        var nextDraft = allDraftKeputusans[0];
                        loadSessionById(nextDraft.id);
                        if (window.AdminToast) {
                            AdminToast.success('Draf evaluasi keputusan "' + displayName + '" berhasil dihapus. Beralih ke evaluasi "' + nextDraft.namaKeputusan + '".');
                        }
                    } else {
                        resetWorkspacePengadaan('Draf evaluasi keputusan "' + displayName + '" berhasil dihapus.');
                    }
                } else {
                    renderDaftarDraftPengadaan();
                    if (window.AdminToast) {
                        AdminToast.success('Draf evaluasi keputusan "' + displayName + '" berhasil dihapus.');
                    }
                }
            },
            error: function () {
                alert('Gagal menghapus evaluasi keputusan dari database.');
            }
        });
    }

    function hapusPengadaanAktif() {
        if (!currentSessionId) return;
        var nama = currentParent ? currentParent.nama : 'ini';
        hapusDraftPengadaan(currentSessionId, nama);
    }

    function resetWorkspacePengadaan(msg) {
        currentSessionId = null;
        currentSessionKode = null;
        currentSessionStatus = "Draft";
        currentParent = null;
        activeSuppliers = [];
        cellValues = {};
        lastCalcResult = null;

        localStorage.removeItem('activePengadaanId');
        window.history.replaceState({}, '', window.location.pathname);

        $('#cardHasil').hide();
        $('#prosesMsg').hide();
        $('#workspacePengadaan').hide();
        $('#dividerDaftarPengadaan').hide();

        renderDaftarDraftPengadaan();

        if (allDraftKeputusans.length === 0) {
            $('#emptyStateNoPengadaan').fadeIn(200);
        }

        if (window.AdminToast && msg) {
            AdminToast.success(msg);
        }
    }

    function buatSesiBaru() {
        openParentModal(false);
    }

    function loadSessionById(id) {
        $.ajax({
            url: API_BASE_URL + '/keputusans/' + id,
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (!data) return;

                currentSessionId = data.id;
                currentSessionKode = data.kodeKeputusan;
                currentSessionStatus = data.status;

                localStorage.setItem('activePengadaanId', data.id);
                window.history.replaceState({ id: data.id }, '', window.location.pathname + '?id=' + data.id);

                renderDaftarDraftPengadaan();

                currentParent = {
                    nama: data.namaKeputusan || '',
                    tanggal: data.tanggalKeputusan ? data.tanggalKeputusan.split('T')[0] : '',
                    aspekId: data.aspekId,
                    catatan: data.keterangan || ''
                };

                currentAspekId = data.aspekId || null;

                // Tampilkan info parent aktif
                $('#dispNamaPengadaan').text(currentParent.nama);
                $('#dispKodePengadaan').text(data.kodeKeputusan || 'KPTS-DRAFT');
                $('#dispTanggalPengadaan').text(currentParent.tanggal ? new Date(currentParent.tanggal).toLocaleDateString('id-ID') : '-');

                updateDispAspek();

                $('#dispCatatanPengadaan').text(currentParent.catatan || '-');

                $('#emptyStateNoPengadaan').hide();
                $('#workspacePengadaan').show();
                if (allDraftKeputusans.length > 0) {
                    $('#dividerDaftarPengadaan').show();
                } else {
                    $('#dividerDaftarPengadaan').hide();
                }
                renderWorkspaceAspekSelect();
                updateActiveParameters();

                activeSuppliers = [];
                cellValues = {};

                if (data.details && data.details.length > 0) {
                    for (var i = 0; i < data.details.length; i++) {
                        var d = data.details[i];
                        activeSuppliers.push({
                            id: d.supplierId,
                            kode: d.kodeSupplier || ('SPL-' + (i + 1).toString().padStart(3, '0')),
                            nama: d.namaSupplier
                        });

                        if (d.nilais && d.nilais.length > 0) {
                            for (var j = 0; j < d.nilais.length; j++) {
                                var n = d.nilais[j];
                                cellValues[d.supplierId + '_' + n.parameterId] = n.nilaiRiil;
                            }
                        }
                    }
                }

                renderTableSupplier();
                renderMatriksPenilaian();

                var hasScores = data.details && data.details.some(function (d) { return d.skorAkhir !== null && d.skorAkhir !== undefined && d.skorAkhir > 0; });
                if (hasScores) {
                    var calculatedRankings = data.details.map(function (d) {
                        var realVals = {};
                        if (d.nilais) {
                            d.nilais.forEach(function (n) { realVals[n.parameterId] = n.nilaiRiil; });
                        }
                        return {
                            peringkat: d.peringkat || 1,
                            supplierId: d.supplierId,
                            kodeSupplier: d.kodeSupplier,
                            namaSupplier: d.namaSupplier,
                            skorAkhir: d.skorAkhir,
                            statusRekomendasi: d.statusRekomendasi || 'Pilihan',
                            realValues: realVals,
                            normalizedScores: {}
                        };
                    });

                    lastCalcResult = {
                        rankings: calculatedRankings,
                        parameterWeights: activeParameters.map(function (p) {
                            return {
                                parameterId: p.id,
                                kodeParameter: p.kode,
                                namaParameter: p.nama,
                                sifatKriteria: p.sifat,
                                bobot: p.bobot / 100.0,
                                persentase: p.bobot
                            };
                        }),
                        winnerHighlight: ""
                    };

                    tampilkanHasil(lastCalcResult);
                } else {
                    $('#cardHasil').hide();
                }
            },
            error: function () {
                localStorage.removeItem('activePengadaanId');
                window.history.replaceState({}, '', window.location.pathname);
                resetWorkspacePengadaan();
            }
        });
    }
</script>
}
