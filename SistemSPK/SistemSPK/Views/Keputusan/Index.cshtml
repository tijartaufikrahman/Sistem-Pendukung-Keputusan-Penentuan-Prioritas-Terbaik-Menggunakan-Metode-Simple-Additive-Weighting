                var pId = activeParameters[p].id;
                var key = sup.id + '_' + pId;
                var val = cellValues[key] !== undefined ? cellValues[key] : '';

                bodyHtml += '<td style="padding: 6px 8px;">' +
                    '<input type="number" step="any" class="form-control form-control-sm text-end font-monospace cell-input-nilai" ' +
