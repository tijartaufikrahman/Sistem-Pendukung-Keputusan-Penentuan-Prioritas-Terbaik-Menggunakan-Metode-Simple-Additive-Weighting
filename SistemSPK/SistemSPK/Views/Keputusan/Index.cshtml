            <button type="button" class="btn-add" id="btnSaveSupplier" onclick="saveSupplierFromModal()">
                <i class="fas fa-save me-1"></i> Simpan Alternatif
            </button>
        </div>
    </div>
</div>



@* =========================================================================
   SCRIPTS: STATE MANAGEMENT & DYNAMIC PARENT-CHILD FLOW
   ========================================================================= *@
@section Scripts {
<script>
    // State Aplikasi
    var allAspeks = [];
    var allParameters = [];
    var allSuppliers = [];
    var allDraftKeputusans = [];

    var currentSessionId = null;
    var currentSessionKode = null;
    var currentSessionStatus = "Draft";

    // Data Parent Aktif
    var currentParent = null; // { nama, tanggal, aspekId, catatan }
    var isEditingParent = false;

    var currentAspekId = null;
    var activeParameters = [];   // [{ id, kode, nama, satuan, sifat, bobot }]
    var activeSuppliers = [];    // [{ id, kode, nama }]
    var cellValues = {};         // { [supId_paramId]: value }
    var lastCalcResult = null;

    function esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escapeAttr(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/'/g, '&#39;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    // ================================================================
    // 1. INISIALISASI & LOAD DATA
    // ================================================================
    $(function () {
        var today = new Date().toISOString().split('T')[0];
        $('#mTanggalPengadaan').val(today);

        var urlParams = new URLSearchParams(window.location.search);
        var targetSessionId = urlParams.get('id') || localStorage.getItem('activePengadaanId');

        loadInitialData(targetSessionId);
    });

    function loadInitialData(targetSessionId) {
        $.when(
            $.ajax({ url: API_BASE_URL + '/aspeks', type: 'GET', dataType: 'json' }),
            $.ajax({ url: API_BASE_URL + '/parameters', type: 'GET', dataType: 'json' }),
            $.ajax({ url: API_BASE_URL + '/suppliers', type: 'GET', dataType: 'json' }),
            $.ajax({ url: API_BASE_URL + '/keputusans', type: 'GET', dataType: 'json' })
        ).done(function (aspeksRes, paramsRes, suppliersRes, keputusansRes) {
            allAspeks = (aspeksRes && aspeksRes[0]) ? aspeksRes[0] : [];
            allParameters = (paramsRes && paramsRes[0]) ? paramsRes[0] : [];
            allSuppliers = (suppliersRes && suppliersRes[0]) ? suppliersRes[0] : [];

            var rawKeputusans = (keputusansRes && keputusansRes[0]) ? keputusansRes[0] : [];
            allDraftKeputusans = rawKeputusans.filter(function (k) {
                return k.status === 'Draft' || !k.status || k.status === '';
            });

            renderWorkspaceAspekSelect();
            renderDaftarDraftPengadaan();

            var sessionToOpen = null;
            if (targetSessionId) {
                var found = allDraftKeputusans.find(function (d) { return d.id === targetSessionId; });
                if (found) sessionToOpen = found.id;
            }

            if (!sessionToOpen && allDraftKeputusans.length > 0) {
                sessionToOpen = allDraftKeputusans[0].id;
            }

            if (sessionToOpen) {
                loadSessionById(sessionToOpen);
            } else {
                $('#cardDaftarKegiatanPengadaan').hide();
                $('#workspacePengadaan').hide();
                $('#emptyStateNoPengadaan').fadeIn(200);
            }
        }).fail(function () {
            $.get(API_BASE_URL + '/aspeks', function (d) { allAspeks = d || []; renderWorkspaceAspekSelect(); });
            $.get(API_BASE_URL + '/parameters', function (d) { allParameters = d || []; });
            $.get(API_BASE_URL + '/suppliers', function (d) { allSuppliers = d || []; });
            $.get(API_BASE_URL + '/keputusans', function (d) {
                var raw = d || [];
                allDraftKeputusans = raw.filter(function (k) { return k.status === 'Draft' || !k.status || k.status === ''; });
                renderDaftarDraftPengadaan();
                if (targetSessionId) loadSessionById(targetSessionId);
                else if (allDraftKeputusans.length > 0) loadSessionById(allDraftKeputusans[0].id);
            });
        });
    }

    // ================================================================
    // 2. DAFTAR KEGIATAN PENGADAAN (DRAF) / MODAL SESI
    // ================================================================
    function openModalDaftarSesi() {
        renderDaftarDraftPengadaan();
        $('#modalDaftarSesi').css('display', 'flex');
    }

    function closeModalDaftarSesi() {
        $('#modalDaftarSesi').hide();
    }

    function closeModalDaftarSesiOverlay(ev) {
        if (ev && ev.target === $('#modalDaftarSesi')[0]) {
            closeModalDaftarSesi();
        }
    }

    function renderDaftarDraftPengadaan() {
        var count = allDraftKeputusans.length;
        $('#badgeCountSesiTop').text(count);
        $('#modalCountDraf').text(count + ' Sesi');

        if (count === 0) {
            $('#btnDaftarSesiTop').hide();
            closeModalDaftarSesi();
            if (!currentSessionId) {
                $('#workspacePengadaan').hide();
                $('#emptyStateNoPengadaan').show();
            }
            return;
        }

        $('#btnDaftarSesiTop').show();
        $('#emptyStateNoPengadaan').hide();

        var html = '';
        for (var i = 0; i < allDraftKeputusans.length; i++) {
            var d = allDraftKeputusans[i];
            var isActive = (d.id === currentSessionId);
            var rowClass = isActive ? 'row-active' : '';

            var tglFormatted = d.tanggalKeputusan
                ? new Date(d.tanggalKeputusan).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : '-';

            var statusBadge = isActive
                ? '<span class="badge bg-success text-white px-2 py-1"><i class="fas fa-check-circle me-1"></i> Sedang Aktif</span>'
                : '<span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Draf</span>';

            var actionBtn = isActive
                ? '<button type="button" class="btn btn-sm text-white px-2.5 py-1" style="font-size:11.5px; background:#0f766e; border-color:#0f766e; font-weight:600;" onclick="closeModalDaftarSesi(); scrollKeWorkspace();" title="Evaluasi ini sedang aktif dibuka"><i class="fas fa-check me-1"></i> Sedang Dibuka</button>'
                : '<button type="button" class="btn btn-sm btn-outline-primary px-2.5 py-1" style="font-size:11.5px; font-weight:600;" onclick="pilihDraftPengadaan(\'' + d.id + '\')" title="Pilih dan buka evaluasi ini"><i class="fas fa-play me-1"></i> Buka Evaluasi</button>';

            var deleteBtn = '<button type="button" class="btn btn-del ms-1.5" title="Hapus draf evaluasi ini" onclick="hapusDraftPengadaan(\'' + d.id + '\', \'' + escapeAttr(d.namaKeputusan) + '\')"><i class="fas fa-trash-alt"></i></button>';

            html += '<tr class="' + rowClass + '">' +
                '<td class="tc" style="color:#0f172a; font-weight:600; font-size:13px;">' + (i + 1) + '</td>' +
                '<td><strong style="color:#0f172a; font-size:13px;">' + esc(d.kodeKeputusan || 'KPTS-DRAFT') + '</strong></td>' +
                '<td>' +
                    '<a href="javascript:void(0)" onclick="pilihDraftPengadaan(\'' + d.id + '\')" class="fw-bold text-decoration-none" style="color:#0f172a; font-size:13px;" title="' + esc(d.keterangan || d.namaKeputusan) + '">' + esc(d.namaKeputusan) + '</a>' +
                '</td>' +
                '<td class="tc text-muted" style="font-size:11.5px;"><i class="fas fa-calendar-alt text-teal me-1"></i> ' + tglFormatted + '</td>' +
                '<td style="font-size:12px;">' + ((d.namaAspek && d.namaAspek !== '-') ? ('<i class="fas fa-layer-group text-indigo me-1"></i> ' + esc(d.namaAspek)) : '<span class="badge bg-light text-secondary border fw-normal" style="font-size:10.5px;">Belum Dipilih</span>') + '</td>' +
                '<td class="tc">' +
                    '<span class="badge bg-light text-dark border px-2 py-1 font-monospace" style="font-size:11px;">' +
                        '<i class="fas fa-cube text-teal me-1"></i> ' + (d.jumlahSupplier || 0) + ' Kandidat' +
                    '</span>' +
                '</td>' +
                '<td class="tc">' + statusBadge + '</td>' +
                '<td class="tc">' +
                    '<div class="d-inline-flex align-items-center justify-content-center">' +
                        actionBtn +
                        deleteBtn +
                    '</div>' +
                '</td>' +
            '</tr>';
        }

        $('#tbodyDaftarDraftPengadaan').html(html);
    }

    function refreshDraftList(callback) {
        $.ajax({
            url: API_BASE_URL + '/keputusans?status=Draft',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                var raw = res || [];
                allDraftKeputusans = raw.filter(function (k) {
                    return k.status === 'Draft' || !k.status || k.status === '';
                });
                renderDaftarDraftPengadaan();
                if (callback) callback(allDraftKeputusans);
            },
            error: function () {
                if (callback) callback(allDraftKeputusans);
            }
        });
    }

    function pilihDraftPengadaan(id) {
        if (!id) return;
        closeModalDaftarSesi();
        if (currentSessionId === id) {
            scrollKeWorkspace();
            return;
        }

        if (currentParent && currentSessionId) {
            simpanDrafKeputusan(true);
        }

        loadSessionById(id);
        scrollKeWorkspace();
    }

    function scrollKeWorkspace() {
        $('#workspacePengadaan').show();
        $('html, body').animate({
            scrollTop: $('#workspacePengadaan').offset().top - 20
        }, 400);
    }

    // ================================================================
    // 3. MODAL DATA PARENT (EVALUASI KEPUTUSAN) & ASPEK WORKSPACE
    // ================================================================
    function renderWorkspaceAspekSelect() {
        var $sel = $('#selectAspekWorkspace');
        $sel.empty();

        $sel.append('<option value="">-- Pilih Aspek Penilaian --</option>');

        if (allAspeks.length === 0) {
            return;
        }

        for (var i = 0; i < allAspeks.length; i++) {
            var a = allAspeks[i];
            var count = (a.parameters || []).length;
            $sel.append('<option value="' + a.id + '">' + esc(a.kodeAspek) + ' - ' + esc(a.namaAspek) + ' (' + count + ' Kriteria)</option>');
        }

        if (currentAspekId) {
            $sel.val(currentAspekId);
        } else {
            $sel.val('');
        }

        updateDispAspek();
    }

    function onAspekWorkspaceChanged(newAspekId) {
        currentAspekId = newAspekId ? newAspekId : null;
        if (currentParent) {
            currentParent.aspekId = currentAspekId;
        }

        updateDispAspek();
        updateActiveParameters();
        renderMatriksPenilaian();
        if (currentSessionId && currentAspekId) {
            simpanDrafKeputusan(true);
        }

        if (window.AdminToast) {
            if (currentAspekId) {
                var asp = allAspeks.find(function (a) { return a.id === currentAspekId; });
                AdminToast.info('Aspek kriteria diubah ke: ' + (asp ? asp.namaAspek : ''));
            } else {
                AdminToast.info('Silakan pilih aspek penilaian.');
            }
        }
    }

    function updateDispAspek() {
        if (!currentAspekId) {
            $('#dispAspekPengadaan').html('<strong class="text-secondary">Belum Dipilih</strong>');
            return;
        }
        var asp = allAspeks.find(function (a) { return a.id === currentAspekId; });
        $('#dispAspekPengadaan').html('<strong class="text-dark">' + esc(asp ? (asp.kodeAspek + ' - ' + asp.namaAspek) : '-') + '</strong>');
    }

    function openParentModal(isEdit) {
        isEditingParent = !!isEdit;
        $('#mErrNamaPengadaan').text('');

        if (isEditingParent && currentParent) {
            $('#modalParentTitle').text('Edit Evaluasi Keputusan');
            $('#mNamaPengadaan').val(currentParent.nama || '');
            $('#mTanggalPengadaan').val(currentParent.tanggal || new Date().toISOString().split('T')[0]);
            $('#mCatatanPengadaan').val(currentParent.catatan || '');
            $('#btnSaveParent').html('<i class="fas fa-check-circle me-1"></i> Simpan Perubahan');
        } else {
            currentAspekId = null;
            $('#modalParentTitle').text('Tambah Evaluasi Keputusan Baru');
            $('#mNamaPengadaan').val('');
            var today = new Date().toISOString().split('T')[0];
            $('#mTanggalPengadaan').val(today);
            $('#mCatatanPengadaan').val('');
            $('#btnSaveParent').html('<i class="fas fa-check-circle me-1"></i> Simpan &amp; Lanjutkan');
        }

        $('#modalParentPengadaan').css('display', 'flex');
        $('#mNamaPengadaan').focus();
    }

    function closeParentModal() {
        $('#modalParentPengadaan').hide();
    }

    function closeParentModalOverlay(ev) {
        if (ev && ev.target === $('#modalParentPengadaan')[0]) {
            closeParentModal();
        }
    }

    function saveParentPengadaan() {
        var nama = $('#mNamaPengadaan').val().trim();
        var tgl = $('#mTanggalPengadaan').val();
        var catatan = $('#mCatatanPengadaan').val().trim();

        if (!nama) {
            $('#mErrNamaPengadaan').text('Nama kegiatan evaluasi wajib diisi.');
            $('#mNamaPengadaan').focus();
            return;
        }

        var defaultAspekId = isEditingParent ? (currentAspekId || null) : null;

        var $btn = $('#btnSaveParent');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Menyimpan ke DB...');

        var targetId = isEditingParent ? (currentSessionId || null) : null;
        var targetKode = isEditingParent ? (currentSessionKode || null) : null;

        var details = [];
        if (isEditingParent && activeSuppliers.length > 0) {
            details = activeSuppliers.map(function (sup) {
                var isGuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(sup.id);
                return {
                    supplierId: isGuid ? sup.id : null,
                    namaSupplier: sup.nama,
                    statusRekomendasi: "Draft",
                    nilais: activeParameters.map(function (p) {
                        var rawVal = cellValues[sup.id + '_' + p.id];
                        var parsed = parseFloat(rawVal);
                        return {
                            parameterId: p.id,
                            nilaiRiil: isNaN(parsed) ? 0 : parsed
                        };
                    })
                };
            });
        }

        var payload = {
            id: targetId,
            kodeKeputusan: targetKode,
            namaKeputusan: nama,
            tanggalKeputusan: tgl ? new Date(tgl) : new Date(),
            aspekId: defaultAspekId,
            keterangan: catatan || null,
            status: "Draft",
            details: details
        };

        $.ajax({
            url: API_BASE_URL + '/keputusans',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            dataType: 'json',
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> ' + (isEditingParent ? 'Simpan Perubahan' : 'Simpan &amp; Lanjutkan'));

                closeParentModal();

                if (isEditingParent) {
                    currentParent.nama = nama;
                    currentParent.tanggal = tgl;
                    currentParent.catatan = catatan;

                    $('#dispNamaPengadaan').text(nama);
                    $('#dispTanggalPengadaan').text(tgl ? new Date(tgl).toLocaleDateString('id-ID') : '-');
                    $('#dispCatatanPengadaan').text(catatan || '-');

                    refreshDraftList();
                    if (window.AdminToast) AdminToast.success('Data evaluasi keputusan berhasil diperbarui.');
                } else {
                    currentSessionId = res.id;
                    currentSessionKode = res.kode;
                    currentSessionStatus = "Draft";

                    refreshDraftList(function () {
                        loadSessionById(res.id);
                        scrollKeWorkspace();
                    });

                    if (window.AdminToast) AdminToast.success('Evaluasi keputusan baru berhasil dibuat.');
                }
            },
            error: function (xhr) {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> ' + (isEditingParent ? 'Simpan Perubahan' : 'Simpan &amp; Lanjutkan'));
                var errMsg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Gagal menyimpan evaluasi keputusan.';
                alert(errMsg);
            }
        });
    }

    // ================================================================
    // 3. ASPEK & PARAMETER LOGIC
    // ================================================================
    function updateActiveParameters() {
        if (!currentAspekId) {
            activeParameters = [];
            renderBobotTable();
            renderMatriksPenilaian();
            return;
        }

        var asp = allAspeks.find(function (a) { return a.id === currentAspekId; });
        var params = (asp && asp.parameters && asp.parameters.length > 0)
            ? asp.parameters
            : allParameters.filter(function (p) { return p.aspekId === currentAspekId; });

        var count = params.length;
        var equalShare = count > 0 ? Math.floor(100 / count) : 0;
        var remainder = count > 0 ? (100 - (equalShare * count)) : 0;

        var dbWeightsSum = 0;
        for (var i = 0; i < params.length; i++) {
            dbWeightsSum += (params[i].bobot || 0);
        }
        var useDbWeights = (dbWeightsSum > 0);

        activeParameters = params.map(function (p, idx) {
            var w = useDbWeights ? (p.bobot !== undefined && p.bobot !== null ? p.bobot : 0) : (equalShare + (idx === 0 ? remainder : 0));
            return {
                id: p.id,
                kode: p.kodeParameter,
                nama: p.namaParameter,
                satuan: p.satuan || '',
                sifat: p.sifatKriteria || 'Cost',
                bobot: w
            };
        });

        renderBobotTable();
        renderMatriksPenilaian();
    }

    function renderBobotTable() {
        if (!currentAspekId) {
            $('#tbodyBobotKriteria').html('<tr><td colspan="6" class="tc py-4 text-muted"><i class="fas fa-layer-group text-teal me-1"></i> Silakan pilih aspek penilaian terlebih dahulu pada pilihan di atas.</td></tr>');
            $('#badgeTotalBobot').html('<i class="fas fa-info-circle me-1"></i> Pilih Aspek').attr('class', 'badge bg-light text-muted border px-2.5 py-1.5 fw-bold');
            return;
        }

        if (activeParameters.length === 0) {
            $('#tbodyBobotKriteria').html('<tr><td colspan="6" class="tc py-4 text-muted">Belum ada parameter kriteria pada aspek yang dipilih.</td></tr>');
            $('#badgeTotalBobot').html('<i class="fas fa-exclamation-circle me-1"></i> 0 Parameter').attr('class', 'badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5 fw-bold');
            return;
        }

        var html = '';
        var totalBobot = 0;
        for (var i = 0; i < activeParameters.length; i++) {
            var p = activeParameters[i];
            totalBobot += p.bobot;
            var sifatBadge = p.sifat === 'Cost'
                ? '<span class="pill-cost"><i class="fas fa-arrow-down"></i> Cost</span>'
                : '<span class="pill-benefit"><i class="fas fa-arrow-up"></i> Benefit</span>';

            html += '<tr>' +
                '<td class="tc" style="color:#0f172a; font-weight:600; font-size:13px;">' + (i + 1) + '</td>' +
                '<td><strong style="color:#0f172a; font-size:13px;">' + esc(p.kode) + '</strong></td>' +
                '<td class="prog-name"><strong style="color:#0f172a; font-size:13px;">' + esc(p.nama) + '</strong></td>' +
                '<td class="tc" style="color:#0f172a; font-weight:500; font-size:13px;">' + esc(p.satuan || '-') + '</td>' +
                '<td class="tc">' + sifatBadge + '</td>' +
                '<td class="tc">' +
                    '<div class="input-group input-group-sm mx-auto" style="max-width:120px;">' +
                        '<input type="number" min="0" max="100" step="any" class="form-control text-end font-monospace fw-bold" ' +
                        'value="' + p.bobot + '" oninput="onBobotCellChanged(\'' + p.id + '\', this.value)" style="font-size:12px;" />' +
                        '<span class="input-group-text fw-bold" style="font-size:11px;">%</span>' +
                    '</div>' +
                '</td>' +
            '</tr>';
        }
        $('#tbodyBobotKriteria').html(html);
        updateBobotBadges(totalBobot);
    }

    function onBobotCellChanged(paramId, val) {
        var p = activeParameters.find(function (item) { return item.id === paramId; });
        if (p) p.bobot = parseFloat(val) || 0;

        var total = 0;
        for (var i = 0; i < activeParameters.length; i++) {
            total += activeParameters[i].bobot;
        }
        total = Math.round(total * 10) / 10;
        updateBobotBadges(total);
    }

    function updateBobotBadges(total) {
        var $badge = $('#badgeTotalBobot');
        if (Math.abs(total - 100) < 0.01) {
            $badge.html('<i class="fas fa-check-circle me-1"></i> Total: 100%')
                  .attr('class', 'badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-bold');
        } else {
            $badge.html('<i class="fas fa-exclamation-triangle me-1"></i> Total: ' + total + '% (Harus 100%)')
                  .attr('class', 'badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5 fw-bold');
        }
    }

    function bagiRataBobot() {
        var count = activeParameters.length;
        if (count === 0) return;
        var equalShare = Math.floor(100 / count);
        var remainder = 100 - (equalShare * count);

        for (var i = 0; i < count; i++) {
            activeParameters[i].bobot = equalShare + (i === 0 ? remainder : 0);
        }
        renderBobotTable();
        if (window.AdminToast) AdminToast.info('Bobot prioritas kriteria berhasil dibagi rata 100%.');
    }

    function simpanBobotParameterKeDatabase() {
        if (activeParameters.length === 0) return;

        var total = 0;
        for (var i = 0; i < activeParameters.length; i++) {
            total += activeParameters[i].bobot;
        }
        total = Math.round(total * 10) / 10;

        if (Math.abs(total - 100) > 0.01) {
            Swal.fire('Validasi Bobot', 'Total akumulasi bobot prioritas kriteria harus tepat 100% (saat ini: ' + total + '%).', 'warning');
            return;
        }

        var items = activeParameters.map(function (p) {
            return { id: p.id, bobot: p.bobot };
        });

        $('#btnSimpanBobotDb').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Menyimpan...');

        $.ajax({
            url: API_BASE_URL + '/parameters/batch-bobot',
            type: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify(items),
            dataType: 'json',
            success: function (res) {
                $('#btnSimpanBobotDb').prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Bobot ke DB');
                if (window.AdminToast) AdminToast.success(res.message || 'Bobot kriteria berhasil disimpan ke database!');
                else Swal.fire('Sukses', 'Bobot kriteria berhasil disimpan ke database!', 'success');
            },
            error: function () {
                $('#btnSimpanBobotDb').prop('disabled', false).html('<i class="fas fa-save me-1"></i> Simpan Bobot ke DB');
                Swal.fire('Gagal', 'Gagal menyimpan bobot kriteria.', 'error');
            }
        });
    }

